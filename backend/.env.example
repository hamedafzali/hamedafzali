# MongoDB connection string
# Docker Compose example: mongodb://mongo:27017/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# Server port
PORT=5001

# Admin token for GET /api/contacts. Set to any strong random string
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=replace_with_a_strong_random_secret

# Mistral API key (https://console.mistral.ai/). Setting it turns on the
# "Ask about Hamed" chat; leave empty to hide it. No rebuild needed.
MISTRAL_API_KEY=

# Optional: Mistral model to try first. Empty picks automatically, skipping
# models the key can't use.
MISTRAL_MODEL=

# Optional: max chat questions per day for the whole site (default 400).
CHAT_DAILY_LIMIT=

# Optional: questions each visitor can ask per day (default 10).
CHAT_PER_VISITOR=
