# Application Configuration
NODE_ENV=production
PORT=5001

# Database Configuration
# Option 1: Local MongoDB (with Docker)
MONGODB_URI=mongodb://host.docker.internal:27017/portfolio

# Option 2: MongoDB Atlas (recommended for production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# Option 3: External MongoDB
# MONGODB_URI=mongodb://username:password@external-mongodb-host:27017/portfolio

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Optional: JWT Secret (if implementing authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optional: Session Secret
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Cloudflare Tunnel (optional - for reference)
TUNNEL_DOMAIN=your-domain.com
TUNNEL_NAME=hamed-profile-tunnel
